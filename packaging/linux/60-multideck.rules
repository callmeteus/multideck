# Elgato Stream Deck access for non root users.
#
# Install with:
#   sudo cp packaging/linux/60-multideck.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Unplug and replug the deck after installing the rule.

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0fd9", TAG+="uaccess", MODE="0660", GROUP="plugdev"
